// ==============================================================================
// Muhammad Kairu Electronics — Prisma Schema
// Reconciled with canonical Supabase PostgreSQL schema and versioned SQL migrations.
// Native Supabase SQL migrations under supabase/migrations/ remain the database source of truth.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum EmployeeRole {
  OWNER              @map("owner")
  PRODUCT_MANAGER    @map("product_manager")
  INVENTORY_MANAGER  @map("inventory_manager")
  CUSTOMER_SUPPORT   @map("customer_support")
  MARKETING_MANAGER  @map("marketing_manager")
  VIEWER             @map("viewer")

  @@map("employee_role")
}

enum MembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  INVITED   @map("invited")

  @@map("membership_status")
}

enum StockStatus {
  CONFIRM_WITH_STORE @map("confirm_with_store")
  IN_STOCK           @map("in_stock")
  OUT_OF_STOCK       @map("out_of_stock")

  @@map("stock_status")
}

enum EnquiryStatus {
  NEW         @map("new")
  CONTACTED   @map("contacted")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  CLOSED      @map("closed")

  @@map("enquiry_status")
}

enum StockMovementReason {
  INITIAL_STOCK @map("initial_stock")
  RESTOCK       @map("restock")
  CORRECTION    @map("correction")
  DAMAGE        @map("damage")
  SALE_ENQUIRY  @map("sale_enquiry")
  OTHER         @map("other")

  @@map("stock_movement_reason")
}

enum AnalyticsEventType {
  PAGE_VIEW             @map("page_view")
  PRODUCT_VIEW          @map("product_view")
  SEARCH_SUBMISSION     @map("search_submission")
  SEARCH_ZERO_RESULTS   @map("search_zero_results")
  CATEGORY_VIEW         @map("category_view")
  ENQUIRY_SUBMISSION    @map("enquiry_submission")
  WHATSAPP_CLICK        @map("whatsapp_click")
  PHONE_CLICK           @map("phone_click")

  @@map("analytics_event_type")
}

// ------------------------------------------------------------------------------
// Store Configuration
// ------------------------------------------------------------------------------

model StoreSettings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeName         String   @map("store_name")
  tagline           String?
  address           String
  landmark          String?
  city              String   @default("Kaduna")
  state             String   @default("Kaduna State")
  country           String   @default("Nigeria")
  phonePrimary      String   @map("phone_primary")
  phoneSecondary    String?  @map("phone_secondary")
  whatsappNumber    String   @map("whatsapp_number")
  email             String
  openingHours      Json?    @map("opening_hours")
  primaryColor      String   @default("#1F2A44") @map("primary_color")
  secondaryColor    String   @default("#F5A623") @map("secondary_color")
  accentColor       String   @default("#16A34A") @map("accent_color")
  surfaceColor      String   @default("#F7F5F0") @map("surface_color")
  socialLinks       Json?    @map("social_links")
  bannerText        String?  @map("banner_text")
  bannerActive      Boolean  @default(false) @map("banner_active")
  isMaintenanceMode Boolean  @default(false) @map("is_maintenance_mode")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

// ------------------------------------------------------------------------------
// Authentication & Team
// ------------------------------------------------------------------------------

model Profile {
  id                   String               @id @db.Uuid
  fullName             String?              @map("full_name")
  phoneNumber          String?              @map("phone_number")
  avatarUrl            String?              @map("avatar_url")
  isSuperAdmin         Boolean              @default(false) @map("is_super_admin")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employeeMemberships  EmployeeMembership[]
  enquiryNotes         EnquiryNote[]
  assignedEnquiries    Enquiry[]            @relation("AssignedEnquiries")

  @@map("profiles")
}

model EmployeeMembership {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String           @map("profile_id") @db.Uuid
  role         EmployeeRole     @default(VIEWER)
  status       MembershipStatus @default(INVITED)
  invitedEmail String           @map("invited_email")
  invitedBy    String?          @map("invited_by") @db.Uuid
  invitedAt    DateTime         @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile      Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([invitedEmail])
  @@map("employee_memberships")
}

model RolePermission {
  role       EmployeeRole
  permission String
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([role, permission])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// Catalogue
// ------------------------------------------------------------------------------

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products    Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Brand {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products  Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String?           @map("category_id") @db.Uuid
  brandId          String?           @map("brand_id") @db.Uuid
  name             String
  slug             String            @unique
  summary          String
  description      String?
  priceKobo        BigInt?           @map("price_kobo")
  currency         String            @default("NGN")
  stockStatus      StockStatus       @default(CONFIRM_WITH_STORE) @map("stock_status")
  warrantySummary  String?           @map("warranty_summary")
  isFeatured       Boolean           @default(false) @map("is_featured")
  isPublished      Boolean           @default(false) @map("is_published")
  isArchived       Boolean           @default(false) @map("is_archived")
  specifications   Json?             @default("[]")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  images           ProductImage[]
  inventoryRecords InventoryRecord[]
  stockMovements   StockMovement[]
  enquiries        Enquiry[]

  @@index([isPublished, isArchived, isFeatured])
  @@index([categoryId, isPublished])
  @@index([brandId, isPublished])
  @@map("products")
}

model ProductVariant {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  sku              String            @unique
  name             String
  attributes       Json?
  priceKobo        BigInt?           @map("price_kobo")
  stockStatus      StockStatus       @default(CONFIRM_WITH_STORE) @map("stock_status")
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryRecords InventoryRecord[]
  stockMovements   StockMovement[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  storagePath String   @map("storage_path")
  altText     String   @map("alt_text")
  sortOrder   Int      @default(0) @map("sort_order")
  isCover     Boolean  @default(false) @map("is_cover")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ------------------------------------------------------------------------------
// Inventory
// ------------------------------------------------------------------------------

model InventoryRecord {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  stockStatus    StockStatus     @default(CONFIRM_WITH_STORE) @map("stock_status")
  quantity       Int?
  lowStockAlert  Int             @default(3) @map("low_stock_alert")
  lastCountedAt  DateTime?       @map("last_counted_at") @db.Timestamptz(6)
  countedBy      String?         @map("counted_by") @db.Uuid
  internalNote   String?         @map("internal_note")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@index([stockStatus])
  @@map("inventory_records")
}

model StockMovement {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  variantId      String?             @map("variant_id") @db.Uuid
  quantityChange Int                 @map("quantity_change")
  reason         StockMovementReason
  referenceNote  String?             @map("reference_note")
  performedBy    String?             @map("performed_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ------------------------------------------------------------------------------
// Customers & Enquiries
// ------------------------------------------------------------------------------

model Customer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName  String    @map("full_name")
  phone     String    @unique
  email     String?
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  enquiries Enquiry[]

  @@map("customers")
}

model Enquiry {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceCode      String        @unique @map("reference_code")
  customerId         String?       @map("customer_id") @db.Uuid
  productId          String?       @map("product_id") @db.Uuid
  customerName       String        @map("customer_name")
  customerPhone      String        @map("customer_phone")
  customerEmail      String?       @map("customer_email")
  message            String
  status             EnquiryStatus @default(NEW)
  assignedEmployeeId String?       @map("assigned_employee_id") @db.Uuid
  source             String        @default("web_storefront")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt         DateTime?     @map("resolved_at") @db.Timestamptz(6)

  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignedProfile    Profile?      @relation("AssignedEnquiries", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  notes              EnquiryNote[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([productId])
  @@map("enquiries")
}

model EnquiryNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId String   @map("enquiry_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@map("enquiry_notes")
}

// ------------------------------------------------------------------------------
// Analytics & Auditing
// ------------------------------------------------------------------------------

model AnalyticsEvent {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType AnalyticsEventType @map("event_type")
  path      String?
  productId String?            @map("product_id") @db.Uuid
  categoryId String?           @map("category_id") @db.Uuid
  searchQuery String?          @map("search_query")
  metadata  Json?
  sessionId String?            @map("session_id")
  ipHash    String?            @map("ip_hash")
  userAgent String?            @map("user_agent")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, createdAt])
  @@index([productId])
  @@map("analytics_events")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model StoreAnnouncement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  content          String
  announcementType String   @default("info") @map("announcement_type")
  bannerBgColor    String?  @map("banner_bg_color")
  bannerTextColor  String?  @map("banner_text_color")
  displayStart     DateTime @default(now()) @map("display_start") @db.Timestamptz(6)
  displayEnd       DateTime? @map("display_end") @db.Timestamptz(6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, displayStart, displayEnd])
  @@map("store_announcements")
}
