# ------------------------------------------------------------------------------
# Muhammad Kairu Electronics — Environment Configuration Template
# Copy this file to .env and provide verified configuration values.
# NEVER commit .env or expose private secrets to version control.
# ------------------------------------------------------------------------------

# Application Environment
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
TENANT_ID=muhammad-kairu-electronics

# Supabase Public Configuration (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Secret Key (NEVER expose to browser)
# Required for privileged backend administration, webhooks, and worker tasks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Database Connection String (PostgreSQL / Supabase connection pooling or direct)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/mk_electronics?schema=public

# Application Secrets (Must be high-entropy, >= 32 characters)
INVITATION_TOKEN_PEPPER=replace-with-at-least-32-char-random-cryptographic-pepper
SESSION_SECRET=replace-with-at-least-32-char-random-cryptographic-session-secret
